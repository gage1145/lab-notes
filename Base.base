views:
  - type: table
    name: Experiments
    filters:
      and:
        - file.tags.contains("experiment")
    groupBy:
      property: project
      direction: ASC
    order:
      - file.name
      - tags
      - start_date
      - protocols
      - file.embeds
      - status
    sort:
      - property: start_date
        direction: DESC
    columnSize:
      note.tags: 115
      file.embeds: 273
  - type: cards
    name: View 2
    image: note.project
    imageFit: contain
    imageAspectRatio: 0.85
    markers: bullet
    indentProperties: false
